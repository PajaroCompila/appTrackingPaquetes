# Administración: solo para npm run db:provision. No usar en ejecución normal.
SQL_SERVIDOR=192.168.10.150
SQL_PUERTO=1433
SQL_BASE_DATOS=master
SQL_USUARIO=<usuario_administrativo_local>
SQL_CONTRASENA=<secreto_local>
SQL_CIFRAR=false
SQL_CONFIAR_CERTIFICADO=false
SQL_TIEMPO_ESPERA_CONEXION_MS=5000
SQL_TIEMPO_MAXIMO_CONSULTA_MS=10000
SQL_POOL_MINIMO=0
SQL_POOL_MAXIMO=5

# SistemaOrigen: pool separado. sa está aceptado solo como excepción temporal local.
SISTEMA_ORIGEN_SQL_SERVIDOR=192.168.10.150
SISTEMA_ORIGEN_SQL_PUERTO=1433
SISTEMA_ORIGEN_SQL_BASE_DATOS=<base_sistemaOrigen>
SISTEMA_ORIGEN_SQL_USUARIO=<usuario_solo_lectura>
SISTEMA_ORIGEN_SQL_CONTRASENA=<secreto_local>
SISTEMA_ORIGEN_SQL_CIFRAR=false
SISTEMA_ORIGEN_SQL_CONFIAR_CERTIFICADO=false
SISTEMA_ORIGEN_SQL_TIEMPO_ESPERA_CONEXION_MS=5000
SISTEMA_ORIGEN_SQL_TIEMPO_MAXIMO_CONSULTA_MS=10000
SISTEMA_ORIGEN_SQL_POOL_MINIMO=0
SISTEMA_ORIGEN_SQL_POOL_MAXIMO=5

# PedidosBodega: pool separado. El valor normal es pedidos_bodega_app;
# temporalmente puede configurarse sa solo mediante backend/.env ignorado.
PEDIDOS_BODEGA_SQL_SERVIDOR=192.168.10.150
PEDIDOS_BODEGA_SQL_PUERTO=1433
PEDIDOS_BODEGA_SQL_BASE_DATOS=PedidosBodega
PEDIDOS_BODEGA_SQL_USUARIO=pedidos_bodega_app
PEDIDOS_BODEGA_SQL_CONTRASENA=<generada_localmente>
PEDIDOS_BODEGA_SQL_CIFRAR=false
PEDIDOS_BODEGA_SQL_CONFIAR_CERTIFICADO=false
PEDIDOS_BODEGA_SQL_TIEMPO_ESPERA_CONEXION_MS=5000
PEDIDOS_BODEGA_SQL_TIEMPO_MAXIMO_CONSULTA_MS=10000
PEDIDOS_BODEGA_SQL_POOL_MINIMO=0
PEDIDOS_BODEGA_SQL_POOL_MAXIMO=5

# AutenticaciÃ³n local. Generar un secreto aleatorio de al menos 32 caracteres solo en .env.
AUTENTICACION_JWT_SECRETO=<secreto_aleatorio_local>
AUTENTICACION_DURACION_MINUTOS=480

# Servir el build de Angular desde la API. Requiere ejecutar npm run build en frontend.
SERVIR_FRONTEND=false

# Conciliación de despachos contra R1/SAP. Mantener por encima del timeout SQL para no saturar las fuentes.
HISTORIAL_INTERVALO_SINCRONIZACION_MS=60000
